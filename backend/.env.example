# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

PORT=4000

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The "service_role" secret key (NOT the anon key). Keep this private —
# it bypasses Row Level Security and must only ever live on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed origin(s) for CORS - comma-separated if you need more than one
# (e.g. the apex domain plus www). This is read at runtime, so updating it
# in production means changing the CLIENT_ORIGIN env var on the deployed
# backend (Vercel project settings), not just this local file.
CLIENT_ORIGIN=http://localhost:5173,https://renthere.in,https://www.renthere.in

# Optional - only needed to run scripts/run-migration.js (applies
# schema.sql directly instead of pasting it into the Supabase SQL Editor).
# From Supabase: Project home -> "Connect" button -> Connection String ->
# Session pooler. Replace [YOUR-PASSWORD] with your actual DB password
# (Project Settings -> Database has a "reset database password" option).
DATABASE_URL=

# Powers the /api/chat Help Center assistant (Groq's free API). Get a
# free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Automated seller ID verification (Digio's ID Card OCR + Verification
# API) - see src/services/idVerification.js. Optional: leave both unset
# and seller verification runs entirely through the existing manual
# staff-review flow, unchanged. Sign up at https://www.digio.in/ - your
# Client ID/Secret are in the Digio Enterprise Dashboard (Sandbox:
# https://ext-enterprise.digio.in, Production: https://enterprise.digio.in)
# under API Credentials. Sandbox credentials work immediately; production
# ones need Digio's own KYC/approval of your business.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# https://ext.digio.in:444 (sandbox, default if unset) or
# https://api.digio.in (production) - see https://documentation.digio.in/digienvironments/
DIGIO_BASE_URL=https://ext.digio.in:444

# Email notifications - mirrors every in-app notification (new rental
# request, approved/rejected, new message, etc. - see src/lib/notify.js) as
# an email via Resend's API. Optional: leave RESEND_API_KEY unset and
# emails are just skipped, in-app notifications (the navbar bell) still
# work on their own. Sign up free at https://resend.com - no KYC, just an
# email/GitHub signup. Until you verify a sending domain in Resend's
# dashboard (Domains -> Add Domain -> add the DNS records at your
# registrar, same idea as connecting renthere.in to Vercel), Resend will
# only actually deliver to the email address you signed up with - fine for
# testing, not for real users yet.
RESEND_API_KEY=
# Must be "Name <address@yourverifieddomain>" using a domain you've
# verified in Resend - an unverified domain here makes every send fail.
EMAIL_FROM=Rent It <notifications@renthere.in>
# Used to build the absolute link ("Open Rent It" button) inside
# notification emails. Defaults to https://renthere.in if unset.
SITE_URL=https://renthere.in

# Payments (Razorpay) - powers "Pay now" on an approved rental, see
# src/lib/razorpay.js. Optional: leave unset and payment routes just return
# 503, everything else keeps working unpaid. Get instant TEST-mode keys at
# https://dashboard.razorpay.com/ (Settings -> API Keys) - no business KYC
# needed until you switch to live mode and want real money to move.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when registering the webhook URL (<your-backend-url>/api/webhooks/razorpay)
# in Razorpay's dashboard (Settings -> Webhooks) - subscribe it to the
# "payment.captured" event. Used to verify inbound webhook calls actually
# came from Razorpay; this is a fallback path (see webhooks.js), the app
# works without it as long as the frontend's own verify-payment call
# succeeds.
RAZORPAY_WEBHOOK_SECRET=

# Error tracking (Sentry) - reports uncaught exceptions and unhandled
# rejections from the API, see src/lib/sentry.js. Optional: leave unset and
# errors just get logged to the console like before, nothing else changes.
# Free account at https://sentry.io - create a Node/Express project there
# and copy its DSN (Settings -> Projects -> <project> -> Client Keys (DSN)).
SENTRY_DSN=
