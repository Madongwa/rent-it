# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=

# Where the backend API is running
VITE_API_URL=http://localhost:4000/api

# Error tracking (Sentry) - reports uncaught exceptions from the browser,
# see src/lib/sentry.js. Optional: leave unset and errors just stay in the
# browser console, nothing else changes. Free account at https://sentry.io -
# create a React project there and copy its DSN (Settings -> Projects ->
# <project> -> Client Keys (DSN)). Safe to expose in the browser.
VITE_SENTRY_DSN=
